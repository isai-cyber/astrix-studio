# Copia este archivo como .env (en esta misma carpeta) y rellena lo que vayas a usar.
# Las claves solo las lee el servidor local; nunca se envían al navegador.

# fal.ai — para Seedance (video), Flux (imagen), Recraft (vectores) y otros modelos.
# Consíguela en https://fal.ai/dashboard/keys
FAL_KEY=

# Apify — investigación de contenido (TikTok, Instagram Reels, Facebook, YouTube).
# Consíguelo en https://console.apify.com/settings/integrations
APIFY_TOKEN=

# ElevenLabs — voces (narración) y efectos de sonido. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# URL pública donde se publica la app (para que los enlaces /r/CODIGO funcionen fuera de tu equipo).
# Ej.: https://astrix.tudominio.com   (si se deja vacío: http://127.0.0.1:8765)
PUBLIC_BASE_URL=

# MariaDB (las crea la instalación; no compartas este archivo)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=moho_studio
DB_PASSWORD=
DB_NAME=moho_studio

# Correo del administrador inicial (se crea solo si la base está vacía)
ADMIN_EMAIL=admin@astrix.local

# Claude API (opcional). Si no la pones, usa "Claude Code" (el CLI con tu sesión: claude auth login).
ANTHROPIC_API_KEY=

# Ruta al CLI de Claude Code si no está en el PATH.
# CLAUDE_BIN=/Users/tu_usuario/.local/bin/claude
